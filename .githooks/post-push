#!/bin/sh
# Regenerate project_r.zip after pushing and commit/push the updated zip.
# Enable with: git config core.hooksPath .githooks

# Build the zip file
powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/package_addon.ps1

# Check if zip file changed and commit/push it
if git diff --quiet project_r.zip 2>/dev/null; then
  echo "project_r.zip unchanged, skipping commit"
else
  echo "project_r.zip updated, committing and pushing..."
  git add project_r.zip
  git commit -m "Update project_r.zip addon package"
  git push
fi